-- Static workspace->monitor pins (row-major pairs), unified with the macOS
-- AeroSpace scheme. Roles come from the local chezmoi [data]; each pair is
-- emitted only if its key is set, so a missing display drops its rules instead
-- of pinning an empty desc. ws 1/3/5 are each monitor's default. 7-0 unpinned.
{{ if hasKey . "monitor_main" -}}
hl.workspace_rule({ workspace = "1", monitor = {{ printf "desc:%s" .monitor_main | quote }}, default = true })
hl.workspace_rule({ workspace = "2", monitor = {{ printf "desc:%s" .monitor_main | quote }} })
{{ end -}}
{{ if hasKey . "monitor_secondary" -}}
hl.workspace_rule({ workspace = "3", monitor = {{ printf "desc:%s" .monitor_secondary | quote }}, default = true })
hl.workspace_rule({ workspace = "4", monitor = {{ printf "desc:%s" .monitor_secondary | quote }} })
{{ end -}}
{{ if hasKey . "monitor_builtin" -}}
hl.workspace_rule({ workspace = "5", monitor = {{ printf "desc:%s" .monitor_builtin | quote }}, default = true })
hl.workspace_rule({ workspace = "6", monitor = {{ printf "desc:%s" .monitor_builtin | quote }} })
{{ end -}}
